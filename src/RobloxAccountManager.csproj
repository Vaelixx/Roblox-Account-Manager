<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Roblox Account Manager</AssemblyName>
    <RootNamespace>RobloxAccountManager</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>2.2.0</Version>
    <Product>Roblox Account Manager</Product>
    <Company>RAM</Company>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Lean runtime: workstation, non-concurrent GC keeps the memory footprint small for a
         mostly-idle desktop/tray app. (InvariantGlobalization is intentionally NOT set — it
         breaks WPF data-binding culture resolution.) -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredCompilation>true</TieredCompilation>
  </PropertyGroup>

  <!-- Embed the multi-resolution .ico as a WPF resource so Window.Icon can load it via a
       pack URI. WPF then picks the crisp hand-tuned 16/24/32/48 frames per surface (taskbar,
       alt-tab, titlebar) instead of soft-scaling a single 256px bitmap. -->
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <!-- Montserrat (SIL Open Font License, see Assets/Fonts/OFL.txt), subset for page titles and
       figures. Loaded through a pack URI, so nothing gets installed on the user's PC. -->
  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <!-- UI text for every language. English is the source of truth and the fallback for missing keys;
       tools/check-localization.py verifies the other files against it before a release. -->
  <ItemGroup>
    <EmbeddedResource Include="Localization\*.json" LogicalName="Localization.%(Filename).json" />
  </ItemGroup>

  <!-- Ship the changelog inside the exe.
       "What's new" used to have exactly one source: the GitHub release for the running version.
       That fails whenever the release hasn't been published yet, the machine is offline, or the
       unauthenticated GitHub API (60 requests/hour per IP) is exhausted — and the window then
       showed "Release notes could not be loaded" with nothing else to offer. The notes are in
       the repo already, so bake them in and treat the network as an enhancement.

       The whole CHANGELOG.md goes in rather than a per-version file: UpdateService slices out the
       section matching the running version, and the rest backs the "Full changelog" view. Cutting
       a release is then one section plus a <Version> bump — there is no second file to forget,
       which used to mean shipping a build with no changelog at all. -->
  <ItemGroup>
    <EmbeddedResource Include="..\CHANGELOG.md"
                      Condition="Exists('..\CHANGELOG.md')"
                      LogicalName="Changelog.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- SDK gap: the self-contained WindowsDesktop runtime pack is NOT profile-filtered, so a
       WPF-only app still ships the whole WinForms stack (~23 MB). Nothing here touches
       WinForms at runtime anymore (tray + hotkeys are native Win32 via HwndSource), so strip
       it from the publish list before the single-file bundle is assembled. System.Drawing.*
       and Accessibility stay — WPF interop (PresentationFramework-SystemDrawing) uses them. -->
  <Target Name="StripWinFormsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="$([System.String]::Copy('%(ResolvedFileToPublish.Filename)').StartsWith('System.Windows.Forms'))
                     Or '%(ResolvedFileToPublish.Filename)' == 'WindowsFormsIntegration'
                     Or '%(ResolvedFileToPublish.Filename)' == 'Microsoft.VisualBasic.Forms'
                     Or '%(ResolvedFileToPublish.Filename)' == 'System.Drawing.Design'" />
    </ItemGroup>
  </Target>

</Project>
