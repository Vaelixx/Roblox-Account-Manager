<UserControl x:Class="RobloxAccountManager.Views.AccountsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:ctl="clr-namespace:RobloxAccountManager.Controls"
             xmlns:models="clr-namespace:RobloxAccountManager.Models"
             xmlns:vm="clr-namespace:RobloxAccountManager.ViewModels"
             PreviewKeyDown="OnPreviewKeyDown">

    <UserControl.Resources>

        <!-- ================= list row ================= -->
        <DataTemplate x:Key="AccountRow" DataType="{x:Type models:Account}">
            <Grid x:Name="row" Height="46" Background="Transparent"
                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" MinWidth="120" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="52" />
                </Grid.ColumnDefinitions>

                <CheckBox x:Name="check" VerticalAlignment="Center" Focusable="False" Opacity="0"
                          IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <ctl:AvatarView Grid.Column="1" Width="34" Height="34" CornerRadius="8" PipSize="10" HorizontalAlignment="Left"
                                ImageUrl="{Binding ThumbnailUrl}" NameText="{Binding Username}" Presence="{Binding Presence}"
                                RingBrush="{DynamicResource SurfaceBrush}" />

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="8" Height="8" CornerRadius="2" Margin="0,0,7,0" VerticalAlignment="Center"
                                Background="{Binding Color, Converter={StaticResource HexToBrush}}"
                                Visibility="{Binding HasColor, Converter={StaticResource BoolToVis}}" />
                        <TextBlock FontWeight="Medium" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource MaskConverter}">
                                    <Binding Path="DisplayNameOrUser" />
                                    <Binding Path="DataContext.MaskUsernames" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <Path Data="{StaticResource Icon.Star}" Width="11" Height="11" Stretch="Uniform" Margin="6,0,0,0"
                              Fill="{DynamicResource WarningBrush}" VerticalAlignment="Center"
                              Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <TextBlock FontSize="12" Margin="0,2,0,0" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource MaskConverter}">
                                <Binding Path="SecondaryName" />
                                <Binding Path="DataContext.MaskUsernames" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding Presence, Converter={StaticResource PresenceToBrush}}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding StatusLine}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="134" ToolTip="{Binding StatusLine}" />
                </StackPanel>

                <TextBlock Grid.Column="4" Text="{Binding RobuxDisplay}" VerticalAlignment="Center" HorizontalAlignment="Right"
                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,0" />

                <TextBlock Grid.Column="5" Text="{Binding Playtime7dText}" VerticalAlignment="Center" HorizontalAlignment="Right"
                           FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,12,0" TextTrimming="CharacterEllipsis"
                           ToolTip="{DynamicResource Str.Accounts.Column.PlaytimeTip}" />

                <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Path Data="{StaticResource Icon.Monitor}" Style="{StaticResource IconPath}" Width="14" Height="14" Margin="0,0,6,0"
                          Stroke="{DynamicResource PresenceInGameBrush}" ToolTip="{DynamicResource Str.Accounts.Running}"
                          Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                    <Path x:Name="attention" Data="{StaticResource Icon.AlertCircle}" Style="{StaticResource IconPath}" Width="14" Height="14"
                          Stroke="{DynamicResource WarningBrush}" ToolTip="{Binding HealthText}"
                          Visibility="{Binding NeedsAttention, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{DynamicResource Str.Accounts.Menu.Launch}"
                                  Command="{Binding PlacementTarget.Tag.LaunchCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon><Path Data="{StaticResource Icon.Play}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource Str.Accounts.Menu.Browser}"
                                  Command="{Binding PlacementTarget.Tag.OpenBrowserCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon><Path Data="{StaticResource Icon.Browser}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource Str.Accounts.Menu.App}"
                                  Command="{Binding PlacementTarget.Tag.OpenAppCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon><Path Data="{StaticResource Icon.Gamepad}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource Str.Accounts.Menu.Profile}"
                                  Command="{Binding PlacementTarget.Tag.OpenProfileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon><Path Data="{StaticResource Icon.External}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{DynamicResource Str.Accounts.Menu.Pin}"
                                  Command="{Binding PlacementTarget.Tag.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}">
                            <MenuItem.Icon><Path Data="{StaticResource Icon.Star}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource Str.Accounts.Menu.MoveToGroup}"
                                  Command="{Binding PlacementTarget.Tag.SetGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon><Path Data="{StaticResource Icon.Folder}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource Str.Accounts.Menu.CheckSession}"
                                  Command="{Binding PlacementTarget.Tag.ValidateSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon><Path Data="{StaticResource Icon.ShieldCheck}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource Str.Accounts.Menu.CopyId}"
                                  Command="{Binding PlacementTarget.Tag.CopyUserIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon><Path Data="{StaticResource Icon.Hash}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{DynamicResource Str.Accounts.Menu.Remove}" Foreground="{DynamicResource DangerBrush}"
                                  Command="{Binding PlacementTarget.Tag.RemoveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon><Path Data="{StaticResource Icon.Trash}" Style="{StaticResource MenuIcon}" Stroke="{DynamicResource DangerBrush}" /></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Grid.ContextMenu>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="check" Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.HasChecked, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter TargetName="check" Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Health}" Value="Invalid">
                    <Setter TargetName="attention" Property="Stroke" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="AccountRowCompact" DataType="{x:Type models:Account}">
            <Grid Height="30" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" MinWidth="120" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="52" />
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="check" VerticalAlignment="Center" Focusable="False" Opacity="0"
                          IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ctl:AvatarView Grid.Column="1" Width="22" Height="22" CornerRadius="5" PipSize="8" HorizontalAlignment="Left"
                                ImageUrl="{Binding ThumbnailUrl}" NameText="{Binding Username}" Presence="{Binding Presence}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Border Width="8" Height="8" CornerRadius="2" Margin="0,0,7,0" VerticalAlignment="Center"
                            Background="{Binding Color, Converter={StaticResource HexToBrush}}"
                            Visibility="{Binding HasColor, Converter={StaticResource BoolToVis}}" />
                    <TextBlock FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource MaskConverter}">
                                <Binding Path="DisplayNameOrUser" />
                                <Binding Path="DataContext.MaskUsernames" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <Path Data="{StaticResource Icon.Star}" Width="10" Height="10" Stretch="Uniform" Margin="6,0,0,0"
                          Fill="{DynamicResource WarningBrush}" VerticalAlignment="Center"
                          Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding Presence, Converter={StaticResource PresenceToBrush}}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding StatusLine}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="134" />
                </StackPanel>
                <TextBlock Grid.Column="4" Text="{Binding RobuxDisplay}" VerticalAlignment="Center" HorizontalAlignment="Right"
                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,0" />
                <TextBlock Grid.Column="5" Text="{Binding Playtime7dText}" VerticalAlignment="Center" HorizontalAlignment="Right"
                           FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Path Data="{StaticResource Icon.Monitor}" Style="{StaticResource IconPath}" Width="13" Height="13" Margin="0,0,6,0"
                          Stroke="{DynamicResource PresenceInGameBrush}"
                          Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                    <Path x:Name="attention" Data="{StaticResource Icon.AlertCircle}" Style="{StaticResource IconPath}" Width="13" Height="13"
                          Stroke="{DynamicResource WarningBrush}" ToolTip="{Binding HealthText}"
                          Visibility="{Binding NeedsAttention, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="check" Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.HasChecked, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter TargetName="check" Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Health}" Value="Invalid">
                    <Setter TargetName="attention" Property="Stroke" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Stat tile in the inspector -->
        <Style x:Key="Stat" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="ColumnHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================== HEADER ============================== -->
        <Grid Grid.Row="0" Margin="28,0,150,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,0">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" MaxWidth="360" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Caption}" FontSize="13" Margin="14,4,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,0">
                <Button Style="{StaticResource Btn.Secondary}" ctl:Ui.Icon="{StaticResource Icon.Import}" Margin="0,0,8,0"
                        Content="{DynamicResource Str.Accounts.Import}" Click="ImportMenu_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{DynamicResource Str.Accounts.ImportCookies}" Command="{Binding ImportCommand}">
                                <MenuItem.Icon><Path Data="{StaticResource Icon.Import}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Str.Accounts.ImportOther}" Command="{Binding ImportIc3w0lfCommand}">
                                <MenuItem.Icon><Path Data="{StaticResource Icon.Database}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="{DynamicResource Str.Accounts.Export}" Command="{Binding ExportCommand}">
                                <MenuItem.Icon><Path Data="{StaticResource Icon.Export}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Style="{StaticResource Btn.Primary}" ctl:Ui.Icon="{StaticResource Icon.Plus}"
                        Content="{DynamicResource Str.Accounts.Add}" Command="{Binding AddCommand}"
                        ToolTip="Ctrl+N" />
            </StackPanel>
        </Grid>

        <!-- ============================== TOOLBAR ============================== -->
        <Grid Grid.Row="1" Margin="28,4,28,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox x:Name="SearchBox" Style="{StaticResource Input.Search}" Height="32" Width="320" HorizontalAlignment="Left"
                     Margin="0,0,14,0" ctl:Ui.Placeholder="{DynamicResource Str.Accounts.Search}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     PreviewKeyDown="SearchBox_PreviewKeyDown" />

            <!-- Wraps instead of overlapping the controls on the right when the window is narrow. -->
            <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0">
                <RadioButton GroupName="status" Style="{StaticResource Chip}" Content="{DynamicResource Str.Accounts.Filter.All}"
                             ctl:Ui.Badge="{Binding CountAll}"
                             IsChecked="{Binding StatusFilter, Converter={StaticResource EqualsToBool}, ConverterParameter=All}" />
                <RadioButton GroupName="status" Style="{StaticResource Chip}" Content="{DynamicResource Str.Accounts.Filter.Online}"
                             ctl:Ui.Badge="{Binding CountOnline}"
                             IsChecked="{Binding StatusFilter, Converter={StaticResource EqualsToBool}, ConverterParameter=Online}" />
                <RadioButton GroupName="status" Style="{StaticResource Chip}" Content="{DynamicResource Str.Accounts.Filter.InGame}"
                             ctl:Ui.Badge="{Binding CountInGame}"
                             IsChecked="{Binding StatusFilter, Converter={StaticResource EqualsToBool}, ConverterParameter=InGame}" />
                <RadioButton GroupName="status" Style="{StaticResource Chip}" Content="{DynamicResource Str.Accounts.Filter.Offline}"
                             ctl:Ui.Badge="{Binding CountOffline}"
                             IsChecked="{Binding StatusFilter, Converter={StaticResource EqualsToBool}, ConverterParameter=Offline}" />
                <RadioButton GroupName="status" Style="{StaticResource Chip}" Content="{DynamicResource Str.Accounts.Filter.Attention}"
                             ctl:Ui.Badge="{Binding CountAttention}"
                             IsChecked="{Binding StatusFilter, Converter={StaticResource EqualsToBool}, ConverterParameter=Attention}"
                             Visibility="{Binding CountAttention, Converter={StaticResource PositiveToVis}}" />
                <RadioButton GroupName="status" Style="{StaticResource Chip}" Content="{DynamicResource Str.Accounts.Filter.Favorites}"
                             IsChecked="{Binding StatusFilter, Converter={StaticResource EqualsToBool}, ConverterParameter=Favorites}" />
            </WrapPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox Width="150" Height="32" SelectedValue="{Binding SortMode}" SelectedValuePath="Tag"
                          ToolTip="{DynamicResource Str.Accounts.Sort}">
                    <ComboBoxItem Tag="Name" Content="{DynamicResource Str.Accounts.Sort.Name}" />
                    <ComboBoxItem Tag="Status" Content="{DynamicResource Str.Accounts.Sort.Status}" />
                    <ComboBoxItem Tag="Recent" Content="{DynamicResource Str.Accounts.Sort.Recent}" />
                    <ComboBoxItem Tag="Robux" Content="{DynamicResource Str.Accounts.Sort.Robux}" />
                    <ComboBoxItem Tag="Playtime" Content="{DynamicResource Str.Accounts.Sort.Playtime}" />
                </ComboBox>
                <Border Style="{StaticResource Segmented}" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="density" Style="{StaticResource Segment}" Padding="8,0"
                                     ctl:Ui.Icon="{StaticResource Icon.Rows}" ToolTip="{DynamicResource Str.Accounts.Density.Comfortable}"
                                     IsChecked="{Binding IsCompact, Converter={StaticResource InverseBool}}" />
                        <RadioButton GroupName="density" Style="{StaticResource Segment}" Padding="8,0"
                                     ctl:Ui.Icon="{StaticResource Icon.List}" ToolTip="{DynamicResource Str.Accounts.Density.Compact}"
                                     IsChecked="{Binding IsCompact}" />
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource Btn.Icon}" Margin="6,0,0,0" ctl:Ui.Icon="{StaticResource Icon.More}"
                        ToolTip="{DynamicResource Str.Common.More}" Click="MoreMenu_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{DynamicResource Str.Accounts.RefreshAll}" Command="{Binding RefreshAllCommand}" InputGestureText="F5">
                                <MenuItem.Icon><Path Data="{StaticResource Icon.Refresh}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Str.Accounts.GroupRows}" IsCheckable="True" IsChecked="{Binding GroupAccounts}" />
                            <MenuItem Header="{DynamicResource Str.Accounts.SelectAll}" Command="{Binding CheckAllVisibleCommand}" InputGestureText="Ctrl+A" />
                            <MenuItem Header="{DynamicResource Str.Accounts.FindDuplicates}" Command="{Binding FindDuplicatesCommand}">
                                <MenuItem.Icon><Path Data="{StaticResource Icon.Copy}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============================== CONTENT ============================== -->
        <Grid Grid.Row="2" Margin="28,0,28,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="440" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="392" />
            </Grid.ColumnDefinitions>

            <!-- list -->
            <Border Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="16,0,22,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" MinWidth="120" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="52" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="2" Text="{DynamicResource Str.Accounts.Column.Account}" Style="{StaticResource ColumnHeader}" />
                        <TextBlock Grid.Column="3" Text="{DynamicResource Str.Accounts.Column.Status}" Style="{StaticResource ColumnHeader}" />
                        <TextBlock Grid.Column="4" Text="Robux" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="5" Text="{DynamicResource Str.Accounts.Column.Playtime}" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right" Margin="0,0,12,0" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" VerticalAlignment="Bottom" />

                    <ListBox x:Name="AccountsList" Grid.Row="1" Padding="6"
                             ItemsSource="{Binding AccountsView}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             PreviewMouseLeftButtonDown="AccountsList_PreviewMouseLeftButtonDown"
                             MouseDoubleClick="AccountsList_MouseDoubleClick"
                             ContextMenuOpening="AccountsList_ContextMenuOpening">
                        <ListBox.Style>
                            <Style TargetType="ListBox" BasedOn="{StaticResource PlainList}">
                                <Setter Property="ItemTemplate" Value="{StaticResource AccountRow}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                        <Setter Property="ItemTemplate" Value="{StaticResource AccountRowCompact}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource Row}">
                                <Setter Property="Padding" Value="10,2" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="12,14,0,6">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding ItemCount}" FontSize="12" Margin="8,0,0,0" Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>

                    <!-- empty: no accounts at all -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"
                                Visibility="{Binding IsStoreEmpty, Converter={StaticResource BoolToVis}}">
                        <Border Width="52" Height="52" CornerRadius="10" HorizontalAlignment="Center" Background="{DynamicResource SurfaceAltBrush}">
                            <Path Data="{StaticResource Icon.UserPlus}" Style="{StaticResource IconPath}" Width="22" Height="22" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{DynamicResource Str.Accounts.Empty.Title}" Style="{StaticResource Text.Heading}" HorizontalAlignment="Center" Margin="0,16,0,6" />
                        <TextBlock Text="{DynamicResource Str.Accounts.Empty.Body}" Style="{StaticResource Text.Caption}" FontSize="12.5" TextAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                            <Button Style="{StaticResource Btn.Primary}" ctl:Ui.Icon="{StaticResource Icon.Plus}" Content="{DynamicResource Str.Accounts.Add}"
                                    Command="{Binding AddCommand}" />
                            <Button Style="{StaticResource Btn.Secondary}" Margin="8,0,0,0" Content="{DynamicResource Str.Accounts.ImportCookies}"
                                    Command="{Binding ImportCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- empty: filters hide everything -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsFilterEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{DynamicResource Str.Accounts.NoMatch}" Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center" />
                        <Button Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Center" Margin="0,8,0,0"
                                Content="{DynamicResource Str.Accounts.ClearFilters}" Command="{Binding ClearFiltersCommand}" />
                    </StackPanel>

                    <!-- bulk actions -->
                    <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,14" Padding="14,6,6,6"
                            CornerRadius="{StaticResource RadiusLg}" Background="{DynamicResource ElevatedBrush}"
                            BorderBrush="{DynamicResource HairlineStrongBrush}" BorderThickness="1" Effect="{StaticResource ShadowFloating}"
                            Visibility="{Binding HasChecked, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CheckedText}" VerticalAlignment="Center" FontWeight="Medium" Margin="0,0,14,0" />
                            <Button Style="{StaticResource Btn.Primary}" Height="30" ctl:Ui.Icon="{StaticResource Icon.Play}"
                                    Content="{DynamicResource Str.Accounts.Bulk.Launch}" Command="{Binding LaunchCommand}"
                                    Visibility="{Binding IsLaunching, Converter={StaticResource InverseBoolToVis}}" />
                            <Button Style="{StaticResource Btn.Secondary}" Height="30" ctl:Ui.Icon="{StaticResource Icon.Stop}" Foreground="{DynamicResource DangerBrush}"
                                    Content="{DynamicResource Str.Launch.Stop}" Command="{Binding StopLaunchCommand}"
                                    Visibility="{Binding IsLaunching, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource Btn.Ghost}" Height="30" Margin="4,0,0,0" ctl:Ui.Icon="{StaticResource Icon.Folder}"
                                    Content="{DynamicResource Str.Accounts.Bulk.Group}" Command="{Binding SetGroupCommand}" />
                            <Button Style="{StaticResource Btn.Ghost}" Height="30" ctl:Ui.Icon="{StaticResource Icon.ShieldCheck}"
                                    Content="{DynamicResource Str.Accounts.Bulk.Check}" Command="{Binding ValidateSelectedCommand}" />
                            <Button Style="{StaticResource Btn.Ghost}" Height="30" ctl:Ui.Icon="{StaticResource Icon.Trash}" Foreground="{DynamicResource DangerBrush}"
                                    Content="{DynamicResource Str.Accounts.Bulk.Remove}" Command="{Binding RemoveCommand}" />
                            <Border Width="1" Margin="6,6" Background="{DynamicResource HairlineStrongBrush}" />
                            <Button Style="{StaticResource Btn.Icon}" Width="30" Height="30" ctl:Ui.Icon="{StaticResource Icon.Close}"
                                    ToolTip="{DynamicResource Str.Accounts.Bulk.Clear}" Command="{Binding ClearChecksCommand}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- inspector -->
            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <Grid>
                    <!-- nothing selected -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30,0" MaxWidth="280"
                                Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}">
                        <Path Data="{StaticResource Icon.Accounts}" Style="{StaticResource IconPath}" Width="26" Height="26"
                              Stroke="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Str.Inspector.Empty.Title}" Style="{StaticResource Text.Heading}" HorizontalAlignment="Center" Margin="0,14,0,6" />
                        <TextBlock Text="{DynamicResource Str.Inspector.Empty.Body}" Style="{StaticResource Text.Caption}" FontSize="12.5" TextAlignment="Center" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="20,20,20,20">

                            <!-- identity -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ctl:AvatarView Width="52" Height="52" CornerRadius="10" PipSize="13"
                                                ImageUrl="{Binding Selected.ThumbnailUrl}" NameText="{Binding Selected.Username}"
                                                Presence="{Binding Selected.Presence}" RingBrush="{DynamicResource SurfaceBrush}" />
                                <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                                    <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource MaskConverter}">
                                                <Binding Path="Selected.DisplayNameOrUser" />
                                                <Binding Path="MaskUsernames" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock FontSize="12.5" Margin="0,2,0,0" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource MaskConverter}">
                                                <Binding Path="Selected.SecondaryName" />
                                                <Binding Path="MaskUsernames" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding Selected.Presence, Converter={StaticResource PresenceToBrush}}" />
                                        <TextBlock Text="{Binding Selected.StatusLine}" FontSize="12.5" Margin="7,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="190" />
                                        <Border Style="{StaticResource Badge}" Margin="8,0,0,0" ToolTip="{Binding Selected.SubPlaceTip}"
                                                Visibility="{Binding Selected.IsSubPlace, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{DynamicResource Str.Presence.SubPlace}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Style="{StaticResource Btn.Icon}" Command="{Binding ToggleFavoriteCommand}" ToolTip="{DynamicResource Str.Inspector.Pin}">
                                        <Grid>
                                            <Path Data="{StaticResource Icon.Star}" Width="15" Height="15" Stretch="Uniform" Fill="{DynamicResource WarningBrush}"
                                                  Visibility="{Binding Selected.IsFavorite, Converter={StaticResource BoolToVis}}" />
                                            <Path Data="{StaticResource Icon.Star}" Style="{StaticResource IconPath}" Width="15" Height="15"
                                                  Visibility="{Binding Selected.IsFavorite, Converter={StaticResource InverseBoolToVis}}" />
                                        </Grid>
                                    </Button>
                                    <Button Style="{StaticResource Btn.Icon}" ctl:Ui.Icon="{StaticResource Icon.More}" ToolTip="{DynamicResource Str.Common.More}"
                                            Click="MoreMenu_Click">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{DynamicResource Str.Accounts.Menu.CopyId}" Command="{Binding CopyUserIdCommand}">
                                                    <MenuItem.Icon><Path Data="{StaticResource Icon.Hash}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="{DynamicResource Str.Accounts.Menu.MoveToGroup}" Command="{Binding SetGroupCommand}">
                                                    <MenuItem.Icon><Path Data="{StaticResource Icon.Folder}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="{DynamicResource Str.Inspector.RunScript}" Command="{Binding InjectScriptCommand}">
                                                    <MenuItem.Icon><Path Data="{StaticResource Icon.Code}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                                                </MenuItem>
                                                <Separator />
                                                <MenuItem Header="{DynamicResource Str.Accounts.Menu.Remove}" Foreground="{DynamicResource DangerBrush}" Command="{Binding RemoveCommand}">
                                                    <MenuItem.Icon><Path Data="{StaticResource Icon.Trash}" Style="{StaticResource MenuIcon}" Stroke="{DynamicResource DangerBrush}" /></MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- launch -->
                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="{StaticResource RadiusLg}" Padding="14" Margin="0,18,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12" Visibility="{Binding HasGameInfo, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="8">
                                            <Border.Background>
                                                <ImageBrush Stretch="UniformToFill" ImageSource="{Binding GameIcon, Converter={StaticResource UrlToImage}}" />
                                            </Border.Background>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding GameName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding GameCreator}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding PlaceIdText, UpdateSourceTrigger=PropertyChanged}" ctl:Ui.Icon="{StaticResource Icon.Gamepad}"
                                                 ctl:Ui.Placeholder="{DynamicResource Str.Launch.PlacePlaceholder}" Background="{DynamicResource SurfaceBrush}" />
                                        <ToggleButton x:Name="SavedPlacesToggle" Grid.Column="1" Style="{StaticResource Btn.Icon}" Width="34" Height="34" Margin="6,0,0,0"
                                                      ctl:Ui.Icon="{StaticResource Icon.Bookmark}" ToolTip="{DynamicResource Str.Launch.SavedPlaces}"
                                                      IsChecked="{Binding SavedPlacesOpen, Mode=TwoWay}" />
                                        <Popup Grid.Column="1" PlacementTarget="{Binding ElementName=SavedPlacesToggle}" Placement="Bottom" HorizontalOffset="-236"
                                               VerticalOffset="6" StaysOpen="False" AllowsTransparency="True"
                                               IsOpen="{Binding SavedPlacesOpen, Mode=TwoWay}">
                                            <Border Width="270" Margin="0,0,14,18" Padding="4" CornerRadius="{StaticResource RadiusMd}"
                                                    Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource HairlineStrongBrush}" BorderThickness="1"
                                                    Effect="{StaticResource ShadowFloating}" TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
                                                <StackPanel>
                                                    <Button Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="32"
                                                            ctl:Ui.Icon="{StaticResource Icon.Plus}" Content="{DynamicResource Str.Launch.SavePlace}"
                                                            Command="{Binding SavePlaceCommand}" />
                                                    <Border Style="{StaticResource Divider}" Margin="4,4" Visibility="{Binding SavedPlaces.Count, Converter={StaticResource CountNonZeroToVis}}" />
                                                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                                        <ItemsControl ItemsSource="{Binding SavedPlaces}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type models:SavedPlace}">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Button Style="{StaticResource Btn.Ghost}" Height="40" HorizontalContentAlignment="Stretch" Padding="6,0"
                                                                                Command="{Binding DataContext.ApplySavedPlaceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                CommandParameter="{Binding}">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource SurfaceAltBrush}">
                                                                                    <Border CornerRadius="6">
                                                                                        <Border.Background>
                                                                                            <ImageBrush Stretch="UniformToFill" ImageSource="{Binding IconUrl, Converter={StaticResource UrlToImage}}" />
                                                                                        </Border.Background>
                                                                                    </Border>
                                                                                </Border>
                                                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </Button>
                                                                        <Button Grid.Column="1" Style="{StaticResource Btn.Icon}" Width="26" Height="26" Margin="2,0,2,0"
                                                                                Command="{Binding DataContext.RemovePlaceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                CommandParameter="{Binding}" ToolTip="{DynamicResource Str.Common.Remove}">
                                                                            <Path Data="{StaticResource Icon.Close}" Style="{StaticResource IconPath}" Width="9" Height="9" />
                                                                        </Button>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>

                                    <TextBox Margin="0,8,0,0" Text="{Binding JobIdText, UpdateSourceTrigger=PropertyChanged}" ctl:Ui.Icon="{StaticResource Icon.Link}"
                                             ctl:Ui.Placeholder="{DynamicResource Str.Launch.ServerPlaceholder}" Background="{DynamicResource SurfaceBrush}"
                                             ToolTip="{DynamicResource Str.Launch.ServerTip}" />

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource Btn.Primary}" Height="38" HorizontalAlignment="Stretch" ctl:Ui.Icon="{StaticResource Icon.Play}"
                                                Content="{DynamicResource Str.Launch.Launch}" Command="{Binding LaunchCommand}"
                                                Visibility="{Binding IsLaunching, Converter={StaticResource InverseBoolToVis}}" />
                                        <Button Style="{StaticResource Btn.Secondary}" Height="38" HorizontalAlignment="Stretch" ctl:Ui.Icon="{StaticResource Icon.Stop}"
                                                Foreground="{DynamicResource DangerBrush}" Content="{DynamicResource Str.Launch.Stop}" Command="{Binding StopLaunchCommand}"
                                                ToolTip="{DynamicResource Str.Launch.Stop.Tip}"
                                                Visibility="{Binding IsLaunching, Converter={StaticResource BoolToVis}}" />
                                        <Button Grid.Column="1" Style="{StaticResource Btn.Secondary}" Height="38" Width="38" Padding="0" Margin="6,0,0,0"
                                                ctl:Ui.Icon="{StaticResource Icon.ChevronDown}" ToolTip="{DynamicResource Str.Launch.More}" Click="MoreMenu_Click">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{DynamicResource Str.Launch.SmartJoin}" Command="{Binding ShuffleJoinCommand}">
                                                        <MenuItem.Icon><Path Data="{StaticResource Icon.Shuffle}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="{DynamicResource Str.Launch.PingJoin}" Command="{Binding PingJoinCommand}">
                                                        <MenuItem.Icon><Path Data="{StaticResource Icon.Signal}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="{DynamicResource Str.Launch.ServerHop}" Command="{Binding ServerHopCommand}">
                                                        <MenuItem.Icon><Path Data="{StaticResource Icon.Refresh}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="{DynamicResource Str.Launch.Squad}" Command="{Binding SquadJoinCommand}">
                                                        <MenuItem.Icon><Path Data="{StaticResource Icon.Users}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem Header="{DynamicResource Str.Launch.BrowseServers}" Command="{Binding BrowseServersCommand}">
                                                        <MenuItem.Icon><Path Data="{StaticResource Icon.Servers}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="{DynamicResource Str.Launch.OpenApp}" Command="{Binding OpenAppCommand}">
                                                        <MenuItem.Icon><Path Data="{StaticResource Icon.Gamepad}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding FollowText, UpdateSourceTrigger=PropertyChanged}" ctl:Ui.Icon="{StaticResource Icon.Follow}"
                                                 ctl:Ui.Placeholder="{DynamicResource Str.Launch.FollowPlaceholder}" Background="{DynamicResource SurfaceBrush}"
                                                 KeyDown="FollowBox_KeyDown" />
                                        <Button Grid.Column="1" Style="{StaticResource Btn.Secondary}" Margin="6,0,0,0" Background="{DynamicResource SurfaceBrush}"
                                                Content="{DynamicResource Str.Launch.Follow}" Command="{Binding FollowCommand}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- tabs -->
                            <StackPanel Orientation="Horizontal" Margin="2,14,0,0">
                                <RadioButton GroupName="inspectorTab" Style="{StaticResource Tab}" Content="{DynamicResource Str.Inspector.Tab.Overview}"
                                             IsChecked="{Binding InspectorTab, Converter={StaticResource EqualsToBool}, ConverterParameter=Overview}" />
                                <RadioButton GroupName="inspectorTab" Style="{StaticResource Tab}" Content="{DynamicResource Str.Inspector.Tab.Details}"
                                             IsChecked="{Binding InspectorTab, Converter={StaticResource EqualsToBool}, ConverterParameter=Details}" />
                                <RadioButton GroupName="inspectorTab" Style="{StaticResource Tab}" Content="{DynamicResource Str.Inspector.Tab.Security}"
                                             IsChecked="{Binding InspectorTab, Converter={StaticResource EqualsToBool}, ConverterParameter=Security}" />
                                <RadioButton GroupName="inspectorTab" Style="{StaticResource Tab}" Content="{DynamicResource Str.Inspector.Tab.Advanced}"
                                             IsChecked="{Binding InspectorTab, Converter={StaticResource EqualsToBool}, ConverterParameter=Advanced}" />
                            </StackPanel>
                            <Border Style="{StaticResource Divider}" Margin="0,0,0,16" />

                            <!-- ===== Overview ===== -->
                            <StackPanel Visibility="{Binding InspectorTab, Converter={StaticResource EqualsToVis}, ConverterParameter=Overview}">
                                <UniformGrid Columns="2" Margin="0,0,-8,0">
                                    <Border Style="{StaticResource Stat}">
                                        <StackPanel>
                                            <TextBlock Text="Robux" Style="{StaticResource StatLabel}" />
                                            <TextBlock Text="{Binding Selected.RobuxDisplay}" Style="{StaticResource StatValue}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Stat}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Str.Inspector.Rap}" Style="{StaticResource StatLabel}" />
                                            <TextBlock Text="{Binding Selected.RapDisplay}" Style="{StaticResource StatValue}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Stat}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Str.Inspector.Week}" Style="{StaticResource StatLabel}" />
                                            <TextBlock Text="{Binding Selected.Playtime7dText}" Style="{StaticResource StatValue}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Stat}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Str.Inspector.Total}" Style="{StaticResource StatLabel}" />
                                            <TextBlock Text="{Binding Selected.PlaytimeTotalText}" Style="{StaticResource StatValue}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Stat}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Str.Inspector.LastPlayed}" Style="{StaticResource StatLabel}" />
                                            <TextBlock Text="{Binding Selected.LastPlayedText}" Style="{StaticResource StatValue}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Stat}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Str.Inspector.Premium}" Style="{StaticResource StatLabel}" />
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource StatValue}">
                                                        <Setter Property="Text" Value="{DynamicResource Str.Common.No}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Selected.IsPremium}" Value="True">
                                                                <Setter Property="Text" Value="{DynamicResource Str.Common.Yes}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <TextBlock Text="{DynamicResource Str.Inspector.Open}" Style="{StaticResource Text.Label}" Margin="0,8,0,8" />
                                <UniformGrid Columns="2" Margin="0,0,-8,0">
                                    <Button Style="{StaticResource Btn.Secondary}" Margin="0,0,8,8" HorizontalContentAlignment="Left"
                                            ctl:Ui.Icon="{StaticResource Icon.Browser}" Content="{DynamicResource Str.Inspector.Browser}"
                                            Command="{Binding OpenBrowserCommand}" ToolTip="{DynamicResource Str.Inspector.BrowserTip}" />
                                    <Button Style="{StaticResource Btn.Secondary}" Margin="0,0,8,8" HorizontalContentAlignment="Left"
                                            ctl:Ui.Icon="{StaticResource Icon.Gamepad}" Content="{DynamicResource Str.Inspector.App}"
                                            Command="{Binding OpenAppCommand}" ToolTip="{DynamicResource Str.Inspector.AppTip}" />
                                    <Button Style="{StaticResource Btn.Secondary}" Margin="0,0,8,8" HorizontalContentAlignment="Left"
                                            ctl:Ui.Icon="{StaticResource Icon.External}" Content="{DynamicResource Str.Inspector.Profile}"
                                            Command="{Binding OpenProfileCommand}" />
                                    <Button Style="{StaticResource Btn.Secondary}" Margin="0,0,8,8" HorizontalContentAlignment="Left"
                                            ctl:Ui.Icon="{StaticResource Icon.Hash}" Content="{DynamicResource Str.Inspector.CopyId}"
                                            Command="{Binding CopyUserIdCommand}" ToolTip="{Binding Selected.UserId}" />
                                </UniformGrid>
                            </StackPanel>

                            <!-- ===== Details ===== -->
                            <StackPanel Visibility="{Binding InspectorTab, Converter={StaticResource EqualsToVis}, ConverterParameter=Details}">
                                <TextBlock Text="{DynamicResource Str.Inspector.Alias}" Style="{StaticResource Text.Label}" />
                                <TextBox Text="{Binding Selected.Alias, UpdateSourceTrigger=LostFocus}" LostFocus="Detail_LostFocus"
                                         ctl:Ui.Placeholder="{DynamicResource Str.Inspector.AliasPlaceholder}" />

                                <TextBlock Text="{DynamicResource Str.Inspector.Group}" Style="{StaticResource Text.Label}" Margin="0,14,0,6" />
                                <ComboBox ItemsSource="{Binding GroupOptions}" SelectedItem="{Binding SelectedGroupOption, Mode=TwoWay}" />

                                <TextBlock Text="{DynamicResource Str.Inspector.Notes}" Style="{StaticResource Text.Label}" Margin="0,14,0,6" />
                                <TextBox Style="{StaticResource Input.Area}" Text="{Binding Selected.Description, UpdateSourceTrigger=LostFocus}"
                                         LostFocus="Detail_LostFocus" ctl:Ui.Placeholder="{DynamicResource Str.Inspector.NotesPlaceholder}" />

                                <TextBlock Text="{DynamicResource Str.Inspector.Color}" Style="{StaticResource Text.Label}" Margin="0,14,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <ItemsControl ItemsSource="{x:Static vm:AccountsViewModel.TagColors}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Width="24" Height="24" Margin="0,0,8,0" Cursor="Hand"
                                                        Command="{Binding DataContext.SetColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Grid>
                                                                <Border x:Name="ring" CornerRadius="6" BorderThickness="2" BorderBrush="Transparent" />
                                                                <Border Margin="4" CornerRadius="3" Background="{Binding Converter={StaticResource HexToBrush}}" />
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource HairlineStrongBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Style="{StaticResource Btn.Link}" VerticalAlignment="Center" Margin="4,0,0,0"
                                            Content="{DynamicResource Str.Common.Clear}" Command="{Binding SetColorCommand}" CommandParameter="" />
                                </StackPanel>

                                <Border Style="{StaticResource Divider}" Margin="0,18,0,6" />
                                <ctl:SettingItem Padding="0,10" Title="{DynamicResource Str.Inspector.AutoRejoin}"
                                                 Description="{DynamicResource Str.Inspector.AutoRejoinDesc}">
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Selected.AutoRejoin}" Click="Detail_Changed" />
                                </ctl:SettingItem>
                                <ctl:SettingItem Padding="0,10" Title="{DynamicResource Str.Inspector.PinTitle}"
                                                 Description="{DynamicResource Str.Inspector.PinDesc}">
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Selected.IsFavorite}" Click="Detail_Changed" />
                                </ctl:SettingItem>
                            </StackPanel>

                            <!-- ===== Security ===== -->
                            <StackPanel Visibility="{Binding InspectorTab, Converter={StaticResource EqualsToVis}, ConverterParameter=Security}">
                                <TextBlock Text="{DynamicResource Str.Inspector.Session}" Style="{StaticResource Text.Label}" />
                                <Border Style="{StaticResource Panel.Inset}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Path x:Name="HealthIcon" Width="16" Height="16">
                                                <Path.Style>
                                                    <Style TargetType="Path" BasedOn="{StaticResource IconPath}">
                                                        <Setter Property="Data" Value="{StaticResource Icon.ShieldCheck}" />
                                                        <Setter Property="Stroke" Value="{DynamicResource SuccessBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Selected.Health}" Value="Invalid">
                                                                <Setter Property="Data" Value="{StaticResource Icon.XCircle}" />
                                                                <Setter Property="Stroke" Value="{DynamicResource DangerBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Selected.Health}" Value="Stale">
                                                                <Setter Property="Data" Value="{StaticResource Icon.AlertCircle}" />
                                                                <Setter Property="Stroke" Value="{DynamicResource WarningBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Selected.Health}" Value="Old">
                                                                <Setter Property="Data" Value="{StaticResource Icon.AlertCircle}" />
                                                                <Setter Property="Stroke" Value="{DynamicResource WarningBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Selected.Health}" Value="Unchecked">
                                                                <Setter Property="Data" Value="{StaticResource Icon.Shield}" />
                                                                <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <TextBlock Text="{Binding Selected.HealthText}" Margin="9,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                        <Grid Margin="25,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{DynamicResource Str.Inspector.CookieAge}" Style="{StaticResource Text.Caption}" Margin="0,0,16,4" />
                                            <TextBlock Grid.Column="1" Text="{Binding Selected.CookieAgeText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Grid.Row="1" Text="{DynamicResource Str.Inspector.LastChecked}" Style="{StaticResource Text.Caption}" Margin="0,0,16,0" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Selected.LastValidatedText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Style="{StaticResource Btn.Secondary}" ctl:Ui.Icon="{StaticResource Icon.ShieldCheck}"
                                            Content="{DynamicResource Str.Inspector.CheckNow}" Command="{Binding ValidateSelectedCommand}" />
                                    <Button Style="{StaticResource Btn.Secondary}" Margin="8,0,0,0" ctl:Ui.Icon="{StaticResource Icon.LogIn}"
                                            Content="{DynamicResource Str.Inspector.SignInAgain}" Command="{Binding SignInAgainCommand}" />
                                </StackPanel>
                                <Button Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Left" Margin="-10,6,0,0" ctl:Ui.Icon="{StaticResource Icon.Copy}"
                                        Content="{DynamicResource Str.Inspector.CopyCookie}" Command="{Binding CopyCookieCommand}" />

                                <Border Style="{StaticResource Divider}" Margin="0,14,0,16" />

                                <TextBlock Text="{DynamicResource Str.Inspector.TwoFactor}" Style="{StaticResource Text.Label}" />
                                <TextBlock Text="{DynamicResource Str.Inspector.TwoFactorDesc}" Style="{StaticResource Text.Caption}" Margin="0,0,0,10" />
                                <TextBox x:Name="TotpSecretBox" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                         Text="{Binding Selected.TotpSecret, UpdateSourceTrigger=LostFocus}"
                                         ctl:Ui.Icon="{StaticResource Icon.Key}" ctl:Ui.Placeholder="{DynamicResource Str.Inspector.TwoFactorPlaceholder}"
                                         LostFocus="TotpSecret_LostFocus" />
                                <TextBlock Text="{DynamicResource Str.Inspector.TwoFactorInvalid}" Foreground="{DynamicResource DangerBrush}" FontSize="12"
                                           TextWrapping="Wrap" Margin="2,8,0,0" Visibility="{Binding TotpInvalid, Converter={StaticResource BoolToVis}}" />
                                <Border Style="{StaticResource Panel.Inset}" Margin="0,10,0,0" Visibility="{Binding HasTotpCode, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding TotpCode}" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <ProgressBar Maximum="1" Value="{Binding TotpProgress, Mode=OneWay}" Height="3" Margin="0,6,24,4" />
                                            <TextBlock Text="{Binding TotpCountdown}" Style="{StaticResource Text.Caption}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource Btn.Secondary}" VerticalAlignment="Center" ctl:Ui.Icon="{StaticResource Icon.Copy}"
                                                Content="{DynamicResource Str.Common.Copy}" Command="{Binding CopyTotpCommand}" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- ===== Advanced ===== -->
                            <StackPanel Visibility="{Binding InspectorTab, Converter={StaticResource EqualsToVis}, ConverterParameter=Advanced}">
                                <TextBlock Text="{DynamicResource Str.Inspector.Proxy}" Style="{StaticResource Text.Label}" />
                                <TextBlock Text="{DynamicResource Str.Inspector.ProxyDesc}" Style="{StaticResource Text.Caption}" Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Selected.ProxyUrl, UpdateSourceTrigger=LostFocus}" LostFocus="Detail_LostFocus"
                                             FontFamily="{StaticResource MonoFont}" FontSize="12" ctl:Ui.Icon="{StaticResource Icon.Globe}"
                                             ctl:Ui.Placeholder="socks5://host:port" />
                                    <Button Grid.Column="1" Style="{StaticResource Btn.Secondary}" Margin="6,0,0,0"
                                            Content="{DynamicResource Str.Common.Test}" Command="{Binding TestAccountProxyCommand}" />
                                </Grid>
                                <TextBlock Text="{DynamicResource Str.Inspector.ProxyInvalid}" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="2,8,0,0"
                                           Visibility="{Binding AccountProxyValid, Converter={StaticResource InverseBoolToVis}}" />

                                <Border Style="{StaticResource Divider}" Margin="0,18,0,16" />

                                <TextBlock Text="{DynamicResource Str.Inspector.FFlags}" Style="{StaticResource Text.Label}" />
                                <TextBlock Text="{DynamicResource Str.Inspector.FFlagsDesc}" Style="{StaticResource Text.Caption}" Margin="0,0,0,10" />
                                <TextBox Style="{StaticResource Input.Code}" MinHeight="120"
                                         Text="{Binding Selected.FFlags, UpdateSourceTrigger=LostFocus}" LostFocus="Detail_LostFocus"
                                         ctl:Ui.Placeholder="{}{ &quot;FIntDebugForceMSAASamples&quot;: &quot;4&quot; }" />
                                <TextBlock Text="{Binding AccountFFlagWarning}" Foreground="{DynamicResource WarningBrush}" FontSize="12" TextWrapping="Wrap"
                                           Margin="2,8,0,0" Visibility="{Binding AccountFFlagWarning, Converter={StaticResource NullToVis}}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
