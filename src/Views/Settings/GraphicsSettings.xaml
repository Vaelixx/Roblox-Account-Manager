<UserControl x:Class="RobloxAccountManager.Views.Settings.GraphicsSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:RobloxAccountManager.Controls">
    <StackPanel>
        <TextBlock Text="{DynamicResource Str.Settings.Cat.Graphics}" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="{DynamicResource Str.Settings.Cat.Graphics.Desc}" Style="{StaticResource Text.Caption}" FontSize="13" Margin="0,4,0,22" />

        <TextBlock Text="{DynamicResource Str.Graphics.Performance}" Style="{StaticResource Text.Section}" />
        <Border Style="{StaticResource Panel}" Margin="0,0,0,24">
            <ctl:DividerStack>
                <ctl:SettingItem Title="{DynamicResource Str.Graphics.Fps.Title}" Description="{DynamicResource Str.Graphics.Fps.Desc}">
                    <ComboBox Width="180" ItemsSource="{Binding FpsCaps}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding FpsCap}" />
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.Graphics.Fps.Now}" Description="{Binding FpsStatus}" />
            </ctl:DividerStack>
        </Border>

        <TextBlock Text="{DynamicResource Str.Profile.Section}" Style="{StaticResource Text.Section}" />
        <Border Style="{StaticResource Panel}" Margin="0,0,0,24">
            <ctl:DividerStack>
                <ctl:SettingItem Title="{DynamicResource Str.Profile.UltraLowAfk}" Description="{DynamicResource Str.Profile.UltraLowAfk.Desc}" />
                <ctl:SettingItem Title="{DynamicResource Str.Profile.Part.Quality}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AfkLowestQuality}" />
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.Profile.Part.Msaa}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AfkNoAntiAliasing}" />
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.Profile.Part.Textures}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AfkLowestTextures}" />
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.Profile.Part.Grass}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AfkNoGrass}" />
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.Profile.Part.Sky}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AfkGraySky}" />
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.Profile.Part.Lighting}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AfkFreezeLighting}" />
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.Profile.Fps.Title}" Description="{DynamicResource Str.Profile.Fps.Desc}">
                    <StackPanel Orientation="Horizontal">
                        <TextBox Style="{StaticResource Input.Number}" Text="{Binding AfkProfileFpsCap}" />
                        <TextBlock Text="FPS" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.Profile.Minimize.Title}" Description="{DynamicResource Str.Profile.Minimize.Desc}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AfkProfileMinimize}" />
                </ctl:SettingItem>
            </ctl:DividerStack>
        </Border>

        <Grid Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource Str.Graphics.Flags}" Style="{StaticResource Text.Section}" Margin="2,0,0,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding FFlagsSummary}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
            <ctl:DividerStack>
                <ctl:SettingItem Title="{DynamicResource Str.Graphics.Apply.Title}" Description="{DynamicResource Str.Graphics.Apply.Desc}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ApplyFFlags}" />
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.Graphics.Api.Title}" Description="{DynamicResource Str.Graphics.Api.Desc}" IsEnabled="{Binding ApplyFFlags}">
                    <ComboBox Width="180" ItemsSource="{Binding GraphicsApis}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding GraphicsApi}" />
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.Graphics.Quality.Title}" Description="{DynamicResource Str.Graphics.Quality.Desc}" IsEnabled="{Binding ApplyFFlags}">
                    <ComboBox Width="180" ItemsSource="{Binding QualityLevels}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding QualityLevelOverride}" MaxDropDownHeight="320" />
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.Graphics.Msaa.Title}" Description="{DynamicResource Str.Graphics.Msaa.Desc}" IsEnabled="{Binding ApplyFFlags}">
                    <ComboBox Width="180" ItemsSource="{Binding MsaaOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding MsaaSamples}" />
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.Graphics.Texture.Title}" Description="{DynamicResource Str.Graphics.Texture.Desc}" IsEnabled="{Binding ApplyFFlags}">
                    <ComboBox Width="180" ItemsSource="{Binding TextureOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding TextureQuality}" />
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.Graphics.Dpi.Title}" Description="{DynamicResource Str.Graphics.Dpi.Desc}" IsEnabled="{Binding ApplyFFlags}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding DisableDpiScale}" />
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.Graphics.Grass.Title}" Description="{DynamicResource Str.Graphics.Grass.Desc}" IsEnabled="{Binding ApplyFFlags}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding HideGrass}" />
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.Graphics.Sky.Title}" Description="{DynamicResource Str.Graphics.Sky.Desc}" IsEnabled="{Binding ApplyFFlags}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding GraySky}" />
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.Graphics.Voxel.Title}" Description="{DynamicResource Str.Graphics.Voxel.Desc}" IsEnabled="{Binding ApplyFFlags}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding PauseVoxelizer}" />
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.Graphics.AltEnter.Title}" Description="{DynamicResource Str.Graphics.AltEnter.Desc}" IsEnabled="{Binding ApplyFFlags}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AltEnterFullscreen}" />
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.Graphics.Custom.Title}" Description="{DynamicResource Str.Graphics.Custom.Desc}"
                                 IsStacked="True" IsEnabled="{Binding ApplyFFlags}">
                    <StackPanel>
                        <TextBox Style="{StaticResource Input.Code}" MinHeight="120" MaxHeight="260"
                                 ctl:Ui.Placeholder="{}{ &quot;FFlagDebugGraphicsPreferD3D11&quot;: &quot;True&quot; }"
                                 Text="{Binding CustomFFlagsText, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                        <TextBlock Text="{Binding IgnoredFlagsText}" Style="{StaticResource Text.Caption}" Margin="2,8,0,0"
                                   Foreground="{DynamicResource WarningBrush}"
                                   Visibility="{Binding IgnoredFlagsText, Converter={StaticResource NullToVis}}" />
                    </StackPanel>
                </ctl:SettingItem>
            </ctl:DividerStack>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource Btn.Danger}" Content="{DynamicResource Str.Graphics.ClearFlags}" Command="{Binding ClearFFlagsCommand}" />
            <Button Style="{StaticResource Btn.Secondary}" Margin="8,0,0,0" Content="{DynamicResource Str.Graphics.WriteNow}" Command="{Binding ApplyFFlagsNowCommand}" />
        </StackPanel>
        <TextBlock Text="{DynamicResource Str.Graphics.AllowlistNote}" Style="{StaticResource Text.Caption}" Margin="2,14,0,0" />
    </StackPanel>
</UserControl>
