<UserControl x:Class="RobloxAccountManager.Views.Settings.AutomationSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:RobloxAccountManager.Controls">
    <StackPanel>
        <TextBlock Text="{DynamicResource Str.Settings.Cat.Automation}" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="{DynamicResource Str.Settings.Cat.Automation.Desc}" Style="{StaticResource Text.Caption}" FontSize="13" Margin="0,4,0,16" />

        <Border Style="{StaticResource Panel.Inset}" Margin="0,0,0,24" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Path Data="{StaticResource Icon.Calendar}" Style="{StaticResource IconPath}" Margin="0,0,12,0" />
                <TextBlock Grid.Column="1" Text="{DynamicResource Str.AutomationSettings.PresetsHint}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                <Button Grid.Column="2" Style="{StaticResource Btn.Secondary}" Margin="12,0,0,0" Content="{DynamicResource Str.AutomationSettings.OpenPage}"
                        Command="{Binding OpenAutomationCommand}" />
            </Grid>
        </Border>

        <TextBlock Text="{DynamicResource Str.AntiAfk.Section}" Style="{StaticResource Text.Section}" />
        <Border Style="{StaticResource Panel}" Margin="0,0,0,24">
            <ctl:DividerStack>
                <ctl:SettingItem Title="{DynamicResource Str.AntiAfk.Title}" Description="{DynamicResource Str.AntiAfk.Desc}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AntiAfkEnabled}" />
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.AntiAfk.Interval}" Description="{DynamicResource Str.AntiAfk.Interval.Desc}" IsEnabled="{Binding AntiAfkEnabled}">
                    <StackPanel Orientation="Horizontal">
                        <TextBox Style="{StaticResource Input.Number}" Text="{Binding AntiAfkIntervalMinutes}" />
                        <TextBlock Text="{DynamicResource Str.Common.Unit.Minutes}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.AntiAfk.Random}" Description="{DynamicResource Str.AntiAfk.Random.Desc}" IsEnabled="{Binding AntiAfkEnabled}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Str.AntiAfk.Random.UpTo}" Style="{StaticResource Text.Caption}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBox Style="{StaticResource Input.Number}" Text="{Binding AntiAfkIntervalMaxMinutes}" IsEnabled="{Binding AntiAfkRandomize}" />
                        <TextBlock Text="{DynamicResource Str.Common.Unit.Minutes}" Style="{StaticResource Text.Caption}" Margin="8,0,14,0" VerticalAlignment="Center" />
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AntiAfkRandomize}" />
                    </StackPanel>
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.AntiAfk.Key}" Description="{DynamicResource Str.AntiAfk.Key.Desc}" IsEnabled="{Binding AntiAfkEnabled}">
                    <ComboBox Width="120" ItemsSource="{Binding AntiAfkKeys}" SelectedItem="{Binding AntiAfkKey}" />
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.AntiAfk.Focus}" Description="{DynamicResource Str.AntiAfk.Focus.Desc}" IsEnabled="{Binding AntiAfkEnabled}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AntiAfkRestoreFocus}" />
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.AntiAfk.Test}" Description="{DynamicResource Str.AntiAfk.Test.Desc}">
                    <Button Style="{StaticResource Btn.Secondary}" Content="{DynamicResource Str.AntiAfk.TestNow}" Command="{Binding TestAntiAfkCommand}" />
                </ctl:SettingItem>
            </ctl:DividerStack>
        </Border>

        <TextBlock Text="{DynamicResource Str.Watchdog.Section}" Style="{StaticResource Text.Section}" />
        <Border Style="{StaticResource Panel}" Margin="0,0,0,24">
            <ctl:DividerStack>
                <ctl:SettingItem Title="{DynamicResource Str.Watchdog.Title}" Description="{DynamicResource Str.Watchdog.Desc}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding WatchdogEnabled}" />
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.Watchdog.Interval}" Description="{DynamicResource Str.Watchdog.Interval.Desc}" IsEnabled="{Binding WatchdogEnabled}">
                    <StackPanel Orientation="Horizontal">
                        <TextBox Style="{StaticResource Input.Number}" Text="{Binding WatchdogCheckSeconds}" />
                        <TextBlock Text="{DynamicResource Str.Common.Unit.Seconds}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.Watchdog.Disconnect.Title}" Description="{DynamicResource Str.Watchdog.Disconnect.Desc}" IsEnabled="{Binding WatchdogEnabled}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Str.Watchdog.Disconnect.After}" Style="{StaticResource Text.Caption}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBox Style="{StaticResource Input.Number}" Text="{Binding DisconnectMinutes}" IsEnabled="{Binding RejoinOnDisconnect}" />
                        <TextBlock Text="{DynamicResource Str.Common.Unit.Minutes}" Style="{StaticResource Text.Caption}" Margin="8,0,14,0" VerticalAlignment="Center" />
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding RejoinOnDisconnect}" />
                    </StackPanel>
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.Watchdog.Restart.Title}" Description="{DynamicResource Str.Watchdog.Restart.Desc}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Str.Watchdog.Restart.Every}" Style="{StaticResource Text.Caption}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBox Style="{StaticResource Input.Number}" Text="{Binding RestartClientsMinutes}" IsEnabled="{Binding RestartClientsEnabled}" />
                        <TextBlock Text="{DynamicResource Str.Common.Unit.Minutes}" Style="{StaticResource Text.Caption}" Margin="8,0,14,0" VerticalAlignment="Center" />
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding RestartClientsEnabled}" />
                    </StackPanel>
                </ctl:SettingItem>
            </ctl:DividerStack>
        </Border>

        <TextBlock Text="{DynamicResource Str.Ram.Section}" Style="{StaticResource Text.Section}" />
        <Border Style="{StaticResource Panel}">
            <ctl:DividerStack>
                <ctl:SettingItem Title="{DynamicResource Str.Ram.Monitor.Title}" Description="{DynamicResource Str.Ram.Monitor.Desc}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding RamMonitorEnabled}" />
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.Ram.Interval}" IsEnabled="{Binding RamMonitorEnabled}">
                    <StackPanel Orientation="Horizontal">
                        <TextBox Style="{StaticResource Input.Number}" Text="{Binding RamMonitorSeconds}" />
                        <TextBlock Text="{DynamicResource Str.Common.Unit.Seconds}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.Ram.Kill.Title}" Description="{DynamicResource Str.Ram.Kill.Desc}" IsEnabled="{Binding RamMonitorEnabled}">
                    <StackPanel Orientation="Horizontal">
                        <TextBox Style="{StaticResource Input.Number}" Text="{Binding RamLimitMb}" IsEnabled="{Binding AutoCloseOnHighRam}" />
                        <TextBlock Text="MB" Style="{StaticResource Text.Caption}" Margin="8,0,16,0" VerticalAlignment="Center" />
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AutoCloseOnHighRam}" />
                    </StackPanel>
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.Ram.Trim.Title}" Description="{DynamicResource Str.Ram.Trim.Desc}">
                    <StackPanel Orientation="Horizontal">
                        <TextBox Style="{StaticResource Input.Number}" Text="{Binding AutoTrimMinutes}" IsEnabled="{Binding AutoTrimEnabled}" />
                        <TextBlock Text="{DynamicResource Str.Common.Unit.Minutes}" Style="{StaticResource Text.Caption}" Margin="8,0,16,0" VerticalAlignment="Center" />
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AutoTrimEnabled}" />
                    </StackPanel>
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.Ram.Usage}" IsStacked="True">
                    <Grid>
                        <TextBlock Text="{Binding RamStatus}" Style="{StaticResource Text.Mono}" TextWrapping="Wrap" Margin="0,0,140,0" />
                        <Button Style="{StaticResource Btn.Secondary}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Content="{DynamicResource Str.Ram.TrimNow}" Command="{Binding TrimRamCommand}" />
                    </Grid>
                </ctl:SettingItem>
            </ctl:DividerStack>
        </Border>
    </StackPanel>
</UserControl>
